{
  "id": null,
  "uid": "expense-tracker-overview",
  "title": "Expense Tracker Overview",
  "tags": ["expense-tracker", "phase-2a"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tier",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up, tier)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "RED metrics — backend", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx error rate by route",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 request duration by route",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },

    { "id": 101, "type": "row", "title": "Business metrics", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    {
      "id": 4,
      "type": "stat",
      "title": "Users registered (total)",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(users_registered_total)",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Logins (total)",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(user_logins_total)",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Expenses created rate, by category",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(expenses_created_total[5m])) by (category_name)",
          "legendFormat": "{{category_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Total expense amount, by category",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyINR" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(expense_amount_rupees_total) by (category_name)",
          "legendFormat": "{{category_name}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    { "id": 102, "type": "row", "title": "Infrastructure", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 } },
    {
      "id": 8,
      "type": "table",
      "title": "Scrape target health (up)",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Container CPU usage",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) by (name)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container memory usage",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "container_memory_usage_bytes{name!=\"\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "MySQL connections & nginx request rate",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "mysql connections",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(nginx_http_requests_total[5m])",
          "legendFormat": "nginx req/s",
          "refId": "B"
        }
      ]
    },

    { "id": 103, "type": "row", "title": "nginx vs backend latency (claude-phase-4a)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 } },
    {
      "id": 12,
      "type": "timeseries",
      "title": "p95 request duration: nginx (VTS) vs backend",
      "description": "The gap between the nginx and backend lines is nginx's own overhead (proxy time, queueing) — nginx's line should sit at or above the backend's, never below. Third line isolates time nginx spent waiting on the backend specifically (the upstream), as its own number rather than inferred from the gap.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(nginx_vts_server_request_duration_seconds_bucket{host!=\"*\"}[5m])) by (le))",
          "legendFormat": "nginx (full request)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "backend",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(nginx_vts_upstream_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "nginx → backend (upstream wait)",
          "refId": "C"
        }
      ]
    },

    { "id": 104, "type": "row", "title": "SLO / error budget (claude-phase-4b)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 } },
    {
      "id": 13,
      "type": "stat",
      "title": "Availability error budget remaining (30d)",
      "description": "Positive = budget remaining, trending toward 0 = SLO at risk, negative = already breached. Uses the 3d window as the longest-lived proxy for the 30d target — see claude-phase-4b.md §5.",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sli:availability:ratio_rate3d - 0.995) / (1 - 0.995) * 100",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Official (nginx) vs diagnostic (backend) SLIs",
      "description": "If the official line degrades while the diagnostic line stays flat, the problem is in the proxy layer. If both degrade together, it's downstream of nginx — app or DB. See claude-phase-4b.md §1.3.",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sli:availability:ratio_rate5m",
          "legendFormat": "availability (official, nginx)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sli:backend:availability:ratio_rate5m",
          "legendFormat": "availability (diagnostic, backend)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sli:latency:fast_ratio_rate5m",
          "legendFormat": "latency fast-ratio (official, nginx)",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sli:backend:latency:fast_ratio_rate5m",
          "legendFormat": "latency fast-ratio (diagnostic, backend)",
          "refId": "D"
        }
      ]
    }
  ]
}
